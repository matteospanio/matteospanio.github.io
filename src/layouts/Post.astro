---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Toc from '@/components/post/Toc.astro';
import Citation from '@/components/post/Citation.astro';
import HighwireMeta from '@/components/seo/HighwireMeta.astro';
import { postSchema } from '@/lib/schema';
import { site } from '@/config/site';
import type { CiteInput } from '@/lib/cite';
import '@/styles/prose.css';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { data } = post;

const url = new URL(Astro.url.pathname, site.url).href;

const cite: CiteInput & { pdf?: string; keywords?: string[] } = {
  title: data.title,
  date: data.date,
  updated: data.updated,
  url,
  version: data.citation?.version,
  doi: data.citation?.doi,
  conceptDoi: data.citation?.conceptDoi,
  pdf: data.citation?.pdf,
  keywords: data.tags,
};

const schema = [
  postSchema({
    title: data.title,
    description: data.description,
    date: data.date,
    updated: data.updated,
    url,
    lang: data.lang,
    tags: data.tags,
    doi: data.citation?.doi,
  }),
];

const iso = data.date.toISOString();
const human = data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Base
  title={data.title}
  description={data.description}
  math={data.math}
  schema={schema}
  ogType="article"
>
  <HighwireMeta slot="head" cite={cite} />

  <div class="layout">
    <article>
      <header>
        <p class="meta">
          <time datetime={iso}>{human}</time>
          {data.lang === 'it' && <span class="lang" title="Written in Italian">IT</span>}
          {data.tags.map((t) => <a class="tag" href={`/blog/tag/${t}/`}>#{t}</a>)}
        </p>
        <h1>{data.title}</h1>
        <p class="standfirst">{data.description}</p>
      </header>

      {
        data.cover && (
          <Image src={data.cover} alt="" class="cover" widths={[640, 960, 1280]} loading="eager" />
        )
      }

      <div class="prose">
        <slot />
      </div>

      <Citation cite={cite} slug={data.slug} />
    </article>

    <aside>
      <div class="sticky">
        <Toc headings={headings} />
      </div>
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  /* The table of contents fills the column that would otherwise sit empty
     beside a measure-width article. */
  @media (min-width: 1040px) {
    .layout {
      grid-template-columns: minmax(0, var(--measure)) 1fr;
    }
  }

  aside {
    display: none;
  }

  @media (min-width: 1040px) {
    aside {
      display: block;
    }
  }

  .sticky {
    position: sticky;
    top: 5rem;
    max-height: calc(100dvh - 8rem);
    overflow-y: auto;
  }

  article {
    min-width: 0;
    max-width: var(--measure);
  }

  header {
    border-block-end: 1px solid var(--rule);
    padding-block-end: 1.5rem;
    margin-block-end: 2rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-block-end: 0.9rem;
  }

  .tag {
    color: var(--fg-dim);
    text-decoration: none;
  }

  .tag:hover {
    color: var(--accent);
  }

  .lang {
    border: 1px solid var(--rule-strong);
    padding-inline: 0.35em;
    color: var(--warn);
  }

  h1 {
    font-size: var(--step-3);
    margin-block-end: 0.6rem;
  }

  .standfirst {
    font-family: var(--font-sans);
    color: var(--fg-dim);
    font-size: var(--step-1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .cover {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    margin-block-end: 2rem;
  }
</style>
