---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import '@/styles/prose.css';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;

const iso = data.date.toISOString();
const human = data.date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Base title={data.title} description={data.description} math={data.math}>
  <article>
    <header>
      <p class="meta">
        <time datetime={iso}>{human}</time>
        {data.lang === 'it' && <span class="lang" title="Written in Italian">IT</span>}
        {data.tags.map((t) => <span class="tag">#{t}</span>)}
      </p>
      <h1>{data.title}</h1>
      <p class="standfirst">{data.description}</p>
    </header>

    {
      data.cover && (
        <Image src={data.cover} alt="" class="cover" widths={[640, 960, 1280]} loading="eager" />
      )
    }

    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  article {
    max-width: var(--measure);
  }

  header {
    border-block-end: 1px solid var(--rule);
    padding-block-end: 1.5rem;
    margin-block-end: 2rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-block-end: 0.9rem;
  }

  .tag {
    color: var(--fg-dim);
  }

  .lang {
    border: 1px solid var(--rule-strong);
    padding-inline: 0.35em;
    color: var(--warn);
  }

  h1 {
    font-size: var(--step-3);
    margin-block-end: 0.6rem;
  }

  .standfirst {
    font-family: var(--font-sans);
    color: var(--fg-dim);
    font-size: var(--step-1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .cover {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    margin-block-end: 2rem;
  }
</style>
