---
import Base from '@/layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import { getPosts, groupByYear } from '@/lib/blog';

export async function getStaticPaths() {
  const byYear = groupByYear(await getPosts());
  return [...byYear.entries()].map(([year, posts]) => ({
    params: { year: String(year) },
    props: { year, posts },
  }));
}

const { year, posts } = Astro.props;
---

<Base title={`posts from ${year}`} description={`Blog posts published in ${year}.`}>
  <p class="crumb"><a href="/blog/">blog</a> <span>/</span> {year}</p>
  <h1 class="label">{year}</h1>
  <p class="summary">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  <PostList posts={posts} />
</Base>

<style>
  .crumb {
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-block-end: 0.8rem;
  }

  .crumb a {
    color: var(--fg-dim);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--accent);
  }

  h1 {
    margin-block-end: 0.5rem;
  }

  .summary {
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-block-end: 2.5rem;
  }
</style>
