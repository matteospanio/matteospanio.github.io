---
import Base from '@/layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import { getPosts, groupByTerm, groupByYear } from '@/lib/blog';

const posts = await getPosts();
const tags = [...groupByTerm(posts, 'tags').entries()].sort((a, b) => b[1].posts.length - a[1].posts.length);
const years = [...groupByYear(posts).keys()].sort((a, b) => b - a);
---

<Base
  title="blog"
  description="Notes on audio DSP, machine learning and the Python tooling around them."
>
  <h1 class="label">blog</h1>
  <p class="summary">{posts.length} posts. Mostly audio, machine learning and the tools in between.</p>

  <nav class="facets" aria-label="Browse posts">
    <div>
      <span class="facet-label">years</span>
      {years.map((y) => <a href={`/blog/${y}/`}>{y}</a>)}
    </div>
    <div>
      <span class="facet-label">tags</span>
      {
        tags.map(([slug, { label, posts: p }]) => (
          <a href={`/blog/tag/${slug}/`}>
            {label}
            <span class="n">{p.length}</span>
          </a>
        ))
      }
    </div>
  </nav>

  <PostList posts={posts} />
</Base>

<style>
  h1 {
    margin-block-end: 0.8rem;
  }

  .summary {
    font-size: var(--step--1);
    color: var(--fg-faint);
  }

  .facets {
    margin-block: 2rem 3rem;
    display: grid;
    gap: 0.7rem;
    font-size: var(--step--1);
  }

  .facets div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: baseline;
  }

  .facet-label {
    color: var(--fg-faint);
    width: 4rem;
    flex-shrink: 0;
  }

  .facets a {
    color: var(--fg-dim);
    text-decoration: none;
    border: 1px solid var(--rule);
    padding: 0.05em 0.5em;
  }

  .facets a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .n {
    color: var(--fg-faint);
    margin-inline-start: 0.4em;
  }
</style>
