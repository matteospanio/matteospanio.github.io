---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const href = (p: (typeof posts)[number]) =>
  `/blog/${p.data.date.getFullYear()}/${p.data.slug}/`;
---

<Base title="blog" description="Notes on audio DSP, machine learning and the tooling around them.">
  <h1 class="label">blog</h1>
  <ul class="list">
    {
      posts.map((post) => (
        <li>
          <a href={href(post)}>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>
            <span class="title">{post.data.title}</span>
          </a>
          <p class="desc">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  h1 {
    margin-block-end: 2rem;
  }

  .list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.75rem;
    max-width: var(--measure);
  }

  a {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    text-decoration: none;
    color: var(--fg);
  }

  time {
    color: var(--fg-faint);
    font-size: var(--step--1);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-size: var(--step-1);
    border-block-end: 1px solid transparent;
  }

  a:hover .title {
    color: var(--accent);
    border-block-end-color: var(--accent);
  }

  .desc {
    font-family: var(--font-sans);
    color: var(--fg-dim);
    font-size: var(--step--1);
    margin-block-start: 0.4rem;
    padding-inline-start: calc(10ch + 1rem);
  }

  @media (max-width: 560px) {
    a {
      flex-direction: column;
      gap: 0.2rem;
    }
    .desc {
      padding-inline-start: 0;
    }
  }
</style>
