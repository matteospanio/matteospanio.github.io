---
import Base from '@/layouts/Base.astro';
import resume from '@/data/resume.json';
import { site } from '@/config/site';
import { allPublications } from '@/lib/content';
import { PERSON_ID } from '@/lib/schema';

const pubs = await allPublications();

/** "2023-11-01" -> "Nov 2023"; an empty end date means it is still running. */
function ym(value?: string): string {
  if (!value) return 'present';
  const [y, m] = value.split('-');
  if (!m) return y;
  const month = new Date(Number(y), Number(m) - 1).toLocaleString('en-GB', { month: 'short' });
  return `${month} ${y}`;
}

const period = (start?: string, end?: string) => `${ym(start)} – ${ym(end)}`;

const work = [...resume.work].sort((a, b) => (b.startDate ?? '').localeCompare(a.startDate ?? ''));
const education = [...resume.education].sort((a, b) =>
  (b.startDate ?? '').localeCompare(a.startDate ?? ''),
);

const schema = [
  { '@type': 'ProfilePage', name: `${site.name} — CV`, mainEntity: { '@id': PERSON_ID } },
];
---

<Base
  title="cv"
  description={`Curriculum vitae of ${site.name}: research, engineering roles, education, publications and awards.`}
  schema={schema}
>
  <header class="head">
    <div>
      <h1 class="label">cv</h1>
      <p class="who">{site.name} — {site.jobTitle}</p>
    </div>
    <a class="download" href="/assets/pdf/CV.pdf">download pdf ↓</a>
  </header>

  <p class="summary">{resume.basics.summary}</p>

  <section>
    <h2>experience</h2>
    <ol>
      {
        work.map((w) => (
          <li>
            <p class="when">{period(w.startDate, w.endDate)}</p>
            <div>
              <h3>
                {w.position} ·{' '}
                {w.url ? <a href={w.url}>{w.name ?? w.company}</a> : (w.name ?? w.company)}
              </h3>
              {w.summary && <p class="detail">{w.summary}</p>}
              {w.highlights && w.highlights.length > 0 && (
                <ul class="highlights">
                  {w.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <h2>education</h2>
    <ol>
      {
        education.map((e) => (
          <li>
            <p class="when">{period(e.startDate, e.endDate)}</p>
            <div>
              <h3>
                {e.studyType} · {e.url ? <a href={e.url}>{e.institution}</a> : e.institution}
              </h3>
              <p class="detail">
                {e.area}
                {e.score && <span class="score"> — {e.score}</span>}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <h2>skills</h2>
    <dl class="skills">
      {
        resume.skills.map((s) => (
          <>
            <dt>{s.name}</dt>
            <dd>{s.keywords?.join(' · ')}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section>
    <h2>languages</h2>
    <dl class="skills">
      {
        resume.languages.map((l) => (
          <>
            <dt>{l.language}</dt>
            <dd>{l.fluency}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section>
    <h2>awards &amp; certificates</h2>
    <ol>
      {
        [...resume.awards, ...resume.certificates].map((a: any) => (
          <li>
            <p class="when">{ym(a.date)}</p>
            <div>
              <h3>{a.url ? <a href={a.url}>{a.title ?? a.name}</a> : (a.title ?? a.name)}</h3>
              <p class="detail">
                {a.awarder ?? a.issuer}
                {a.summary && <> — {a.summary}</>}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <h2>publications</h2>
    <p class="detail">
      {pubs.length} entries, {pubs.filter((p) => p.year >= 2024).length} since 2024.{' '}
      <a href="/publications/">Full list with abstracts, PDFs and BibTeX →</a>
    </p>
  </section>
</Base>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    justify-content: space-between;
    margin-block-end: 1.5rem;
  }

  .who {
    color: var(--fg-dim);
    margin-block-start: 0.5rem;
  }

  .download {
    font-size: var(--step--1);
    color: var(--fg-dim);
    text-decoration: none;
    border: 1px solid var(--rule-strong);
    padding: 0.25em 0.8em;
  }

  .download:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .summary {
    font-family: var(--font-sans);
    color: var(--fg-dim);
    max-width: var(--measure);
    line-height: 1.6;
    padding-block-end: 2rem;
    border-block-end: 1px solid var(--rule);
  }

  section {
    margin-block-start: 2.5rem;
  }

  h2 {
    font-size: var(--step-0);
    color: var(--fg-faint);
    text-transform: lowercase;
    letter-spacing: 0.08em;
    margin-block-end: 1.2rem;
  }

  h2::before {
    content: '## ';
    color: var(--accent);
  }

  ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }

  ol li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
  }

  .when {
    font-size: var(--step--1);
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    font-size: var(--step-0);
    font-weight: 500;
  }

  h3 a {
    padding-block: 0.3rem;
    color: inherit;
    text-decoration: none;
    border-block-end: 1px solid var(--rule-strong);
  }

  h3 a:hover {
    color: var(--accent);
    border-block-end-color: var(--accent);
  }

  .detail {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--fg-dim);
    margin-block-start: 0.35rem;
    max-width: var(--measure);
    line-height: 1.6;
  }

  .score {
    color: var(--accent);
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin-block-start: 0.4rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }

  .highlights li::before {
    content: '— ';
    color: var(--fg-faint);
  }

  .skills {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.6rem 1rem;
    font-size: var(--step--1);
    max-width: calc(var(--measure) + 11rem);
  }

  dt {
    color: var(--fg-faint);
  }

  dd {
    margin: 0;
    color: var(--fg-dim);
  }

  @media (max-width: 640px) {
    ol li,
    .skills {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    ol li {
      gap: 0.3rem;
    }
  }
</style>
