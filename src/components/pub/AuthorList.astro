---
import type { Author } from '@/lib/bib';

interface Props {
  authors: Author[];
  /** Beyond this, the tail collapses behind a disclosure rather than eating the card. */
  max?: number;
}

const { authors, max = 6 } = Astro.props;

const overflow = authors.length > max;
const head = overflow ? authors.slice(0, max) : authors;
const tail = overflow ? authors.slice(max) : [];

const label = (a: Author) => (a.given ? `${a.given} ${a.family}` : a.family);
---

<p class="authors">
  {
    head.map((a, i) => (
      <>
        {i > 0 && <span class="sep">, </span>}
        {a.url ? (
          <a href={a.url} class={a.isMe ? 'me' : ''}>
            {label(a)}
          </a>
        ) : (
          <span class={a.isMe ? 'me' : ''}>{label(a)}</span>
        )}
      </>
    ))
  }
  {
    overflow && (
      <>
        <span class="sep">, </span>
        <details class="more">
          <summary>+{tail.length} more</summary>
          <span>
            {tail.map((a, i) => (
              <>
                {i > 0 && <span class="sep">, </span>}
                <span class={a.isMe ? 'me' : ''}>{label(a)}</span>
              </>
            ))}
          </span>
        </details>
      </>
    )
  }
</p>

<style>
  .authors {
    font-size: var(--step--1);
    color: var(--fg-dim);
    line-height: 1.5;
  }

  .me {
    color: var(--fg);
    font-weight: 700;
  }

  a {
    color: inherit;
    text-decoration: none;
    border-block-end: 1px solid var(--rule-strong);
  }

  a:hover {
    color: var(--accent);
    border-block-end-color: var(--accent);
  }

  .more {
    display: inline;
  }

  .more summary {
    display: inline;
    /* Padding, not a min-height: this control sits inside the run of author
       names, so growing the line box would break the sentence. */
    padding-block: 0.45rem;
    cursor: pointer;
    color: var(--fg-faint);
    list-style: none;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary:hover {
    color: var(--accent);
  }

  .more[open] summary {
    display: none;
  }
</style>
