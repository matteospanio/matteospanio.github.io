---
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer>
  <div class="shell inner">
    <p class="who">
      <span class="prompt">$</span> {site.name} · {site.affiliation.parent}
    </p>
    <ul>
      <li><a href="/feed.xml">rss</a></li>
      <li><a href="/llms.txt">llms.txt</a></li>
      <li>
        <a href={`https://github.com/${site.handle}/matteospanio.github.io`}>source</a>
      </li>
      <li><span class="dim">© {year}</span></li>
    </ul>
  </div>
</footer>

<style>
  footer {
    margin-block-start: auto;
    border-block-start: 1px solid var(--rule);
    background: var(--bg-1);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.4rem;
  }

  .prompt {
    color: var(--accent);
  }

  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  a {
    color: var(--fg-dim);
    text-decoration: none;
    /* Standalone links, not prose: they need a thumb-sized box. */
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
  }

  a:hover {
    color: var(--accent);
  }

  .dim {
    color: var(--fg-faint);
  }
</style>
