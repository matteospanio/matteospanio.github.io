---
import CopyButton from '@/components/CopyButton.astro';
import { toAPA, toBibTeX, type CiteInput } from '@/lib/cite';

interface Props {
  cite: CiteInput;
  slug: string;
}

const { cite, slug } = Astro.props;

const bibtex = toBibTeX(cite);
const apa = toAPA(cite);
const id = `cite-${slug.replace(/[^a-zA-Z0-9]/g, '-')}`;
const doi = cite.conceptDoi ?? cite.doi;
---

<section class="cite" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>cite this post</h2>

  {
    doi && (
      <p class="doi">
        <span class="k">doi</span>
        <a href={`https://doi.org/${doi}`}>{doi}</a>
        {cite.conceptDoi && cite.doi && cite.conceptDoi !== cite.doi && (
          <span class="note">
            (all versions; this version is{' '}
            <a href={`https://doi.org/${cite.doi}`}>{cite.doi}</a>)
          </span>
        )}
      </p>
    )
  }

  <div class="block">
    <div class="head">
      <span class="k">apa</span>
      <CopyButton target={`${id}-apa`} />
    </div>
    <p id={`${id}-apa`} class="apa">{apa}</p>
  </div>

  <div class="block">
    <div class="head">
      <span class="k">bibtex</span>
      <CopyButton target={`${id}-bib`} />
    </div>
    <pre id={`${id}-bib`} tabindex="0">{bibtex}</pre>
  </div>
</section>

<style>
  .cite {
    margin-block-start: 3.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
    max-width: var(--measure);
  }

  h2 {
    font-size: var(--step--1);
    color: var(--fg-faint);
    letter-spacing: 0.08em;
    margin-block-end: 1.2rem;
  }

  h2::before {
    content: '## ';
    color: var(--accent);
  }

  .k {
    font-size: var(--step--1);
    color: var(--fg-faint);
  }

  .doi {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
    font-size: var(--step--1);
    margin-block-end: 1.2rem;
  }

  .note {
    color: var(--fg-faint);
  }

  .block + .block {
    margin-block-start: 1rem;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 0.4rem;
  }

  .apa {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--fg-dim);
    background: var(--bg-1);
    border: 1px solid var(--rule);
    padding: 0.8rem;
    line-height: 1.6;
  }

  pre {
    background: var(--bg-inset);
    border: 1px solid var(--rule);
    padding: 0.9rem;
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.55;
  }
</style>
