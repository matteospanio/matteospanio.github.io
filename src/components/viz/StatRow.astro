---
import footprint from '@/data/viz/footprint.json';

interface Props {
  /** Link the row to the full dashboard. */
  href?: string;
}

const { href } = Astro.props;
const h = footprint.headline;

const stats = [
  { n: h.publications, label: 'publications' },
  { n: h.citations, label: 'citations' },
  { n: h.coauthors, label: 'coauthors' },
  { n: h.repos, label: 'repositories' },
  { n: h.stars, label: 'github stars' },
  { n: h.hfDownloads, label: 'model downloads' },
].filter((s) => typeof s.n === 'number');
---

<dl class="stats">
  {
    stats.map((s) => (
      <div>
        <dt>{s.label}</dt>
        {/* The number is real text: crawlers and screen readers get it even
            though the count-up animation is purely decorative CSS. */}
        <dd style={`--n: ${s.n}`}>{s.n}</dd>
      </div>
    ))
  }
</dl>

{href && <p class="more"><a href={href}>how this is measured →</a></p>}

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin: 0;
  }

  .stats > div {
    background: var(--bg-1);
    padding: 0.9rem 1rem;
  }

  dt {
    font-size: 0.72rem;
    color: var(--fg-faint);
    letter-spacing: 0.05em;
  }

  dd {
    margin: 0.25rem 0 0;
    font-size: var(--step-2);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    text-shadow: 0 0 18px var(--accent-glow);
  }

  .more {
    margin-block-start: 0.8rem;
    font-size: var(--step--1);
  }

  .more a {
    color: var(--fg-dim);
    text-decoration: none;
  }

  .more a:hover {
    color: var(--accent);
  }

  /*
   * The number is real text, so it is present for crawlers, screen readers and
   * anyone with motion disabled. The animation only fades it in — a CSS
   * counter-based count-up would render a second copy alongside it.
   */
  @media (prefers-reduced-motion: no-preference) {
    dd {
      animation: rise 700ms var(--ease-out) both;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.2em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
