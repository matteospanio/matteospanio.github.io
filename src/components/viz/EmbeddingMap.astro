</style>

<script>
  interface Node {
    id: string;
    kind: string;
    theme: string;
    title: string;
    short: string;
    year?: number;
    venue?: string;
    url: string;
    x: number;
    y: number;
  }

  interface Edge {
    s: string;
    t: string;
    w: number;
  }

  interface Variant {
    seed: number;
    k: number;
    canonical: boolean;
    silhouette: number | null;
    xy: [number, number][];
  }

  // Addressed by data attribute, not by class: the theme colours are read off
  // this element, and a page that happens to wrap it in its own .map section
  // would otherwise resolve every colour to the fallback.
  const figure = document.querySelector<HTMLElement>('[data-emap]');
  const dataEl = document.getElementById('emap-data');
  const canvas = document.getElementById('emap') as HTMLCanvasElement | null;
  const tip = document.getElementById('emap-tip');
  const card = document.getElementById('emap-card');
  const hint = document.getElementById('emap-hint');
  const list = document.getElementById('emap-list');

  if (figure && dataEl && canvas && tip && card) {
    document.documentElement.classList.add('js');

    const { nodes, edges, variants } = JSON.parse(dataEl.textContent!) as {
      nodes: Node[];
      edges: Edge[];
      variants: Variant[];
    };
    const ctx = canvas.getContext('2d')!;
    const index = new Map(nodes.map((n, i) => [n.id, i]));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    /* ---- palette, re-read whenever the theme flips --------------------- */
    let colours = new Map<string, string>();
    let ink = { fg: '#d7dee5', dim: '#8b98a5', rule: '#2a353f', accent: '#4ade80' };
    let fontFamily = 'ui-monospace, monospace';
    // Additive glow only exists on a dark ground; on light the same sprite is a
    // grey smudge. The per-theme value lives in CSS next to the palette.
    let haloAlpha = 0.55;

    function readPalette() {
      const style = getComputedStyle(figure!);
      fontFamily = style.fontFamily || fontFamily;
      haloAlpha = parseFloat(style.getPropertyValue('--halo-alpha')) || 0.55;
      colours = new Map(
        nodes.map((n) => [n.theme, style.getPropertyValue(`--c-${n.theme}`).trim() || '#4ade80']),
      );
      const root = getComputedStyle(document.documentElement);
      ink = {
        fg: root.getPropertyValue('--fg').trim() || ink.fg,
        dim: root.getPropertyValue('--fg-dim').trim() || ink.dim,
        rule: root.getPropertyValue('--rule-strong').trim() || ink.rule,
        accent: root.getPropertyValue('--accent').trim() || ink.accent,
      };
      haloCache.clear();
    }

    /* ---- halo sprites --------------------------------------------------
     * shadowBlur costs a full-canvas blur per draw. A radial-gradient sprite
     * per colour, drawn scaled, is the same picture for a fraction of the
     * frame budget — which is what lets this animate continuously.
     */
    const HALO = 64;
    const haloCache = new Map<string, HTMLCanvasElement>();

    function halo(colour: string): HTMLCanvasElement {
      let sprite = haloCache.get(colour);
      if (sprite) return sprite;

      sprite = document.createElement('canvas');
      sprite.width = sprite.height = HALO;
      const c = sprite.getContext('2d')!;
      const g = c.createRadialGradient(HALO / 2, HALO / 2, 0, HALO / 2, HALO / 2, HALO / 2);
      g.addColorStop(0, colour);
      g.addColorStop(0.18, colour);
      g.addColorStop(1, 'transparent');
      c.fillStyle = g;
      c.globalAlpha = haloAlpha;
      c.beginPath();
      c.arc(HALO / 2, HALO / 2, HALO / 2, 0, Math.PI * 2);
      c.fill();

      haloCache.set(colour, sprite);
      return sprite;
    }

    /* ---- fitted layout -------------------------------------------------
     * The projection preserves aspect, so its extent is not square. Fit the
     * real bounding box, with one uniform scale, so relative distances survive.
     */
    const xs = nodes.map((n) => n.x);
    const ys = nodes.map((n) => n.y);
    const minX = Math.min(...xs);
    const maxX = Math.max(...xs);
    const minY = Math.min(...ys);
    const maxY = Math.max(...ys);
    const spanX = maxX - minX || 1;
    const spanY = maxY - minY || 1;

    let w = 0;
    let h = 0;
    let dpr = 1;
    let fit = 1;
    let offX = 0;
    let offY = 0;

    /* ---- per-node runtime state ---------------------------------------- */
    const KIND_SCALE: Record<string, number> = { paper: 1, project: 0.94, post: 0.88, news: 0.7 };

    const state = nodes.map((n, i) => ({
      // Screen-space position, filled by layout()
      bx: 0,
      by: 0,
      // Drift phase, deterministic so the map looks the same on every load
      phase: (i * 2.399963) % (Math.PI * 2),
      speed: 0.00022 + ((i * 37) % 11) * 0.000018,
      ampX: 3 + ((i * 13) % 7),
      ampY: 2.5 + ((i * 7) % 5),
      // Eased 0..1 interaction weights
      glow: 0,
      lit: 0,
      // Entrance
      appear: 0,
      delay: i * 26,
      sx: 0,
      sy: 0,
      r: 5 * (KIND_SCALE[n.kind] ?? 0.85),
    }));

    /* ---- morphable data coordinates -------------------------------------
     * The scrubber retargets these; layout() projects whatever is current, so
     * swapping projections is nothing but easing 84 numbers. The frame (fit,
     * offsets) stays pinned to the canonical extent, so the stage does not
     * breathe while variants come and go.
     */
    const pos = new Float64Array(nodes.length * 2);
    const posT = new Float64Array(nodes.length * 2);
    nodes.forEach((n, i) => {
      pos[i * 2] = posT[i * 2] = n.x;
      pos[i * 2 + 1] = posT[i * 2 + 1] = n.y;
    });
    let morphing = false;

    function project() {
      for (let i = 0; i < nodes.length; i++) {
        state[i].bx = offX + (pos[i * 2] - minX) * fit;
        state[i].by = offY + (pos[i * 2 + 1] - minY) * fit;
      }
    }

    function layout() {
      // Proportional, so a phone-sized canvas does not spend a third of itself
      // on margin.
      const pad = Math.max(20, Math.min(54, w * 0.055));
      fit = Math.min((w - pad * 2) / spanX, (h - pad * 2) / spanY);
      offX = (w - spanX * fit) / 2;
      offY = (h - spanY * fit) / 2;
      project();
    }

    /* ---- camera --------------------------------------------------------- */
    let k = 1;
    let kT = 1;
    let tx = 0;
    let ty = 0;
    let txT = 0;
    let tyT = 0;
    let vx = 0;
    let vy = 0;

    const toScreenX = (x: number) => x * k + tx;
    const toScreenY = (y: number) => y * k + ty;

    /* ---- interaction state ---------------------------------------------- */
    let hover = -1;
    let picked = -1;
    let filter = 'all';
    let pointerX = -1e6;
    let pointerY = -1e6;
    let pointerIn = false;
    let dragging = false;

    const neighbours = new Map<string, Set<string>>();
    for (const e of edges) {
      if (!neighbours.has(e.s)) neighbours.set(e.s, new Set());
      if (!neighbours.has(e.t)) neighbours.set(e.t, new Set());
      neighbours.get(e.s)!.add(e.t);
      neighbours.get(e.t)!.add(e.s);
    }

    /* ---- latent walk ----------------------------------------------------
     * The edges are a kNN graph over the embedding, which turns "how do I get
     * from this work to that one" into a shortest-path question. Costs favour
     * strong similarities, with a small per-hop tax so the walk prefers a few
     * defensible links over many weak ones.
     */
    const adjacency = new Map<string, { to: string; w: number }[]>();
    const edgeAt = new Map<string, number>();
    edges.forEach((e, i) => {
      if (!adjacency.has(e.s)) adjacency.set(e.s, []);
      if (!adjacency.has(e.t)) adjacency.set(e.t, []);
      adjacency.get(e.s)!.push({ to: e.t, w: e.w });
      adjacency.get(e.t)!.push({ to: e.s, w: e.w });
      edgeAt.set(`${e.s}|${e.t}`, i);
      edgeAt.set(`${e.t}|${e.s}`, i);
    });

    let walkArmed = false;
    let pathActive = false;
    const pathNodeSet = new Set<number>();
    const pathEdgeSet = new Set<number>();

    function shortestPath(fromId: string, toId: string): number[] | null {
      const dist = new Map<string, number>([[fromId, 0]]);
      const prev = new Map<string, string>();
      const settled = new Set<string>();
      // Dijkstra with a linear scan: at 42 nodes a heap is pure ceremony.
      for (;;) {
        let u: string | null = null;
        let best = Infinity;
        for (const [id, d] of dist) {
          if (!settled.has(id) && d < best) {
            u = id;
            best = d;
          }
        }
        if (u === null) return null;
        if (u === toId) break;
        settled.add(u);
        for (const { to, w } of adjacency.get(u) ?? []) {
          const d = best + (1 - w) + 0.02;
          if (d < (dist.get(to) ?? Infinity)) {
            dist.set(to, d);
            prev.set(to, u);
          }
        }
      }
      const ids = [toId];
      while (ids[0] !== fromId) ids.unshift(prev.get(ids[0])!);
      return ids.map((id) => index.get(id)!);
    }

    function clearPath() {
      walkArmed = false;
      pathActive = false;
      pathNodeSet.clear();
      pathEdgeSet.clear();
    }

    /* ---- travelling pulses ----------------------------------------------
     * A slow signal running along an edge every so often. It is the whole
     * reason the map reads as alive rather than as a screenshot. `rev` runs a
     * pulse against the edge's stored direction (paths need both); a negative
     * `p` is a start delay, which is how a traced path becomes a cascade.
     */
    const pulses: { edge: number; p: number; speed: number; rev?: boolean }[] = [];
    let nextPulse = 900;

    /**
     * The walker: where the ambient signal currently sits, and its next hop.
     *
     * Hops follow edges, so successive notes are works the embedding says are
     * neighbours. Preferring the least-recently-visited neighbour makes the
     * walk cover the graph instead of oscillating between two nodes, and keeps
     * it deterministic — the map sounds the same on every load.
     */
    let walker = -1;
    const visited = new Int32Array(nodes.length);
    let visitClock = 0;

    function nextHop(): { edge: number; to: number; rev: boolean } | null {
      if (walker < 0 || !(neighbours.get(nodes[walker].id)?.size)) {
        // Start, or a dead end: jump to the least-visited node that has edges.
        let best = -1;
        for (let i = 0; i < nodes.length; i++) {
          if (!neighbours.get(nodes[i].id)?.size) continue;
          if (filter !== 'all' && nodes[i].theme !== filter) continue;
          if (best < 0 || visited[i] < visited[best]) best = i;
        }
        if (best < 0) return null;
        walker = best;
      }

      const options = [...(neighbours.get(nodes[walker].id) ?? [])]
        .map((id) => index.get(id)!)
        .filter((j) => j !== undefined && (filter === 'all' || nodes[j].theme === filter));
      if (!options.length) {
        walker = -1;
        return null;
      }
      const to = options.reduce((a, b) => (visited[b] < visited[a] ? b : a));
      const edge = edgeAt.get(`${nodes[walker].id}|${nodes[to].id}`);
      if (edge === undefined) return null;
      const rev = edges[edge].s !== nodes[walker].id;
      visited[to] = ++visitClock;
      walker = to;
      return { edge, to, rev };
    }

    /* ---- sound ------------------------------------------------------------
     * An audio rendering of exactly the data the canvas draws — bare Web Audio,
     * no samples, no library. Four decisions carry it:
     *
     * 1. The listener is the camera. Nodes are points on a plane in 3-D heard
     *    through HRTF, and panning or zooming moves you across and above that
     *    plane: what you are looking at is what you hear nearby, zooming in
     *    descends among the works (close, dry), zooming out rises away from
     *    them (distant, reverberant). Stereo pan alone is a picture of a map;
     *    a listener in a room is a place.
     *
     * 2. The ambient layer is a walk, not a shuffle. The travelling pulses hop
     *    along the kNN graph — each departs from where the last one landed —
     *    and every arrival sounds its node on a slow beat. Consecutive notes
     *    are therefore textually neighbouring works: the music is a tour of the
     *    structure rather than a random sprinkle.
     *
     * 3. Timbre means something. Tape flutter for the cultural-heritage work,
     *    a plucked string for the Baroque LilyPond scores, a reedy voice for
     *    musicology, a resonant sweep for the DSP tooling, an FM bell for the
     *    crossmodal work, a short click for engineering.
     *
     * 4. Filtering to one area re-tunes the map to that area's root, so the
     *    legend is also a modal shift.
     *
     * All of it sits low: a drone at the edge of audibility, roughly one note a
     * second, and a master gain well under speech.
     */
    let actx: AudioContext | null = null;
    let master: GainNode | null = null;
    let dryBus: GainNode | null = null;
    let wetBus: GainNode | null = null;
    let droneOscs: OscillatorNode[] = [];
    let droneFilter: BiquadFilterNode | null = null;
    let noiseBuffer: AudioBuffer | null = null;
    let listening = false;
    let voices = 0;

    const BEAT = 1120; // ms — one ambient note per beat, ~54 bpm
    const SCALE = [0, 3, 5, 7, 10]; // minor pentatonic: nothing can clash
    const BASE = 110; // A2

    /** Each research area gets its own tonal centre, in semitones from A. */
    const ROOT: Record<string, number> = {
      'cultural-heritage': 0,
      multimodal: 3,
      'symbolic-music': 5,
      'dsp-tooling': 7,
      musicology: -4,
      engineering: 10,
    };
    let root = 0;

    interface Voice {
      wave: OscillatorType;
      attack: number;
      dur: number;
      cutoff: number;
      q: number;
      gain: number;
      /** carrier-relative FM ratio and depth in Hz */
      fm?: [number, number];
      /** flutter/vibrato rate in Hz and depth in cents */
      wobble?: [number, number];
      /** filter sweeps to this multiple of `cutoff` over the note */
      sweep?: number;
      /** breath noise mixed under the tone */
      breath?: number;
    }

    const VOICES: Record<string, Voice> = {
      // Wow and flutter: the sound of the medium this work rescues.
      'cultural-heritage': {
        wave: 'sine', attack: 0.05, dur: 2.6, cutoff: 1900, q: 0.7, gain: 1,
        wobble: [4.6, 14],
      },
      // Two-operator bell — one modality ringing through another.
      multimodal: {
        wave: 'sine', attack: 0.006, dur: 2.2, cutoff: 3400, q: 0.8, gain: 0.85,
        fm: [3.5, 190],
      },
      // Plucked string for the Baroque scores.
      'symbolic-music': {
        wave: 'triangle', attack: 0.003, dur: 1.1, cutoff: 2800, q: 3, gain: 0.9,
        sweep: 0.28,
      },
      // A resonant filter sweep: the library's own subject matter.
      'dsp-tooling': {
        wave: 'sawtooth', attack: 0.01, dur: 1.6, cutoff: 420, q: 7, gain: 0.42,
        sweep: 5.5,
      },
      // Reedy and breathy — the clarinet in the room.
      musicology: {
        wave: 'triangle', attack: 0.09, dur: 2.8, cutoff: 1500, q: 1.4, gain: 0.8,
        wobble: [5.4, 8], breath: 0.05,
      },
      engineering: {
        wave: 'square', attack: 0.002, dur: 0.55, cutoff: 1700, q: 2, gain: 0.4,
        sweep: 0.4,
      },
    };

    /** Deterministic noise, so the room sounds identical on every load. */
    function makeNoise(seed: number, len: number, fn: (t: number, n: number) => number) {
      let s = seed;
      const next = () => ((s = (s * 1103515245 + 12345) & 0x7fffffff) / 0x3fffffff - 1);
      const out = new Float32Array(len);
      for (let i = 0; i < len; i++) out[i] = fn(i / len, next());
      return out;
    }

    function buildAudio() {
      const ctx = new AudioContext();
      actx = ctx;

      const limiter = ctx.createDynamicsCompressor();
      limiter.threshold.value = -20;
      limiter.ratio.value = 10;
      limiter.attack.value = 0.004;
      master = ctx.createGain();
      master.gain.value = 0;
      master.connect(limiter);
      limiter.connect(ctx.destination);

      // A short, dark room. Bright reverb on a quiet page sounds like a fault.
      const seconds = 2.6;
      const len = Math.floor(ctx.sampleRate * seconds);
      const ir = ctx.createBuffer(2, len, ctx.sampleRate);
      for (let ch = 0; ch < 2; ch++) {
        let lp = 0;
        ir.getChannelData(ch).set(
          makeNoise(ch === 0 ? 8191 : 65537, len, (t, n) => {
            lp += (n - lp) * 0.22; // one-pole: a room, not a spring
            return lp * (1 - t) ** 2.8;
          }),
        );
      }
      const convolver = ctx.createConvolver();
      convolver.buffer = ir;

      dryBus = ctx.createGain();
      wetBus = ctx.createGain();
      dryBus.gain.value = 1;
      wetBus.gain.value = 0.32;
      dryBus.connect(master);
      wetBus.connect(convolver);
      convolver.connect(master);

      // Two seconds of pink-ish noise, reused by every breathy note.
      const nlen = ctx.sampleRate * 2;
      noiseBuffer = ctx.createBuffer(1, nlen, ctx.sampleRate);
      let lp = 0;
      noiseBuffer.getChannelData(0).set(
        makeNoise(4243, nlen, (_t, n) => {
          lp += (n - lp) * 0.06;
          return lp * 3.2;
        }),
      );

      // The drone: root and fifth, barely there, holding the tonality together.
      droneFilter = ctx.createBiquadFilter();
      droneFilter.type = 'lowpass';
      droneFilter.frequency.value = 300;
      droneFilter.Q.value = 0.8;
      const droneGain = ctx.createGain();
      droneGain.gain.value = 0.05;
      droneFilter.connect(droneGain);
      droneGain.connect(dryBus);
      droneGain.connect(wetBus);

      droneOscs = [-6, 6, 1200 - 4].map((detune, n) => {
        const osc = ctx.createOscillator();
        osc.type = n === 2 ? 'sine' : 'triangle';
        osc.frequency.value = BASE / 2;
        osc.detune.value = n === 2 ? 700 : detune; // the third is a fifth up
        const g = ctx.createGain();
        g.gain.value = n === 2 ? 0.35 : 1;
        osc.connect(g);
        g.connect(droneFilter!);
        osc.start();
        return osc;
      });

      // A slow swell on the drone's filter, so the floor is never quite static.
      const lfo = ctx.createOscillator();
      lfo.frequency.value = 0.045;
      const lfoGain = ctx.createGain();
      lfoGain.gain.value = 90;
      lfo.connect(lfoGain);
      lfoGain.connect(droneFilter.frequency);
      lfo.start();

      if (ctx.listener.forwardZ) {
        ctx.listener.forwardZ.value = -1;
        ctx.listener.upY.value = 1;
      }
      moveListener();
    }

    /** Semitone → Hz in the current key. */
    function freqFor(i: number) {
      const up = 1 - (nodes[i].y - minY) / spanY; // top of the map is high
      const step = Math.round(up * 14);
      const degree = SCALE[step % 5] + 12 * Math.floor(step / 5);
      return BASE * 2 ** ((degree + root) / 12);
    }

    /** Node position in the listener's world: the map, laid flat, 14 units wide. */
    const SPREAD = 7;
    const worldOf = (i: number) => ({
      x: (((nodes[i].x - minX) / spanX) * 2 - 1) * SPREAD,
      z: (((nodes[i].y - minY) / spanY) * 2 - 1) * SPREAD,
    });

    /**
     * The camera becomes the listener: centre of the stage in data space, at a
     * height set by the zoom. Zooming in walks you down into the constellation.
     */
    function moveListener() {
      if (!actx || !fit) return;
      const dx = ((w / 2 - tx) / k - offX) / fit + minX;
      const dy = ((h / 2 - ty) / k - offY) / fit + minY;
      const lx = (((dx - minX) / spanX) * 2 - 1) * SPREAD;
      const lz = (((dy - minY) / spanY) * 2 - 1) * SPREAD;
      const ly = Math.max(1.1, Math.min(13, 6 / k));
      const t = actx.currentTime;
      const L = actx.listener;
      if (L.positionX) {
        L.positionX.linearRampToValueAtTime(lx, t + 0.08);
        L.positionY.linearRampToValueAtTime(ly, t + 0.08);
        L.positionZ.linearRampToValueAtTime(lz, t + 0.08);
      } else {
        // Safari still ships only the deprecated setter.
        (L as unknown as { setPosition(x: number, y: number, z: number): void }).setPosition(lx, ly, lz);
      }
      // High above the plane the room takes over; down among the nodes it dries out.
      if (wetBus) wetBus.gain.setTargetAtTime(0.12 + (ly / 13) * 0.42, t, 0.25);
    }

    /**
     * One note. `bright` (0..1) opens the filter — traced paths use it to make a
     * strong similarity link audibly brighter than a weak one.
     */
    function pluck(i: number, gain = 0.09, bright = 0.5, when = 0) {
      if (!actx || !dryBus || actx.state !== 'running' || voices >= 12) return;
      const ctx = actx;
      const v = VOICES[nodes[i].theme] ?? VOICES.multimodal;
      const t0 = ctx.currentTime + when;
      // News items are announcements, not works: shorter and further back.
      const kindTrim = nodes[i].kind === 'news' ? 0.6 : nodes[i].kind === 'post' ? 0.85 : 1;
      const peak = gain * v.gain * kindTrim;
      const dur = v.dur * (nodes[i].kind === 'news' ? 0.6 : 1);
      voices++;

      const osc = ctx.createOscillator();
      osc.type = v.wave;
      osc.frequency.value = freqFor(i);

      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.Q.value = v.q;
      const open = v.cutoff * (0.7 + bright * 0.9);
      filter.frequency.setValueAtTime(open, t0);
      if (v.sweep) filter.frequency.exponentialRampToValueAtTime(open * v.sweep, t0 + dur * 0.8);

      const env = ctx.createGain();
      env.gain.setValueAtTime(0.0001, t0);
      env.gain.exponentialRampToValueAtTime(peak, t0 + v.attack);
      env.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);

      const panner = ctx.createPanner();
      panner.panningModel = 'HRTF';
      panner.distanceModel = 'inverse';
      panner.refDistance = 2.2;
      panner.maxDistance = 60;
      panner.rolloffFactor = 1.15;
      const p = worldOf(i);
      if (panner.positionX) {
        panner.positionX.value = p.x;
        panner.positionY.value = 0;
        panner.positionZ.value = p.z;
      } else {
        (panner as unknown as { setPosition(x: number, y: number, z: number): void }).setPosition(p.x, 0, p.z);
      }

      osc.connect(filter);
      filter.connect(env);
      env.connect(panner);
      panner.connect(dryBus);
      panner.connect(wetBus!);
      osc.start(t0);
      osc.stop(t0 + dur + 0.06);

      const extras: AudioScheduledSourceNode[] = [];
      if (v.fm) {
        const mod = ctx.createOscillator();
        mod.frequency.value = osc.frequency.value * v.fm[0];
        const depth = ctx.createGain();
        depth.gain.setValueAtTime(v.fm[1], t0);
        depth.gain.exponentialRampToValueAtTime(1, t0 + dur * 0.6);
        mod.connect(depth);
        depth.connect(osc.frequency);
        mod.start(t0);
        mod.stop(t0 + dur + 0.06);
        extras.push(mod);
      }
      if (v.wobble) {
        const lfo = ctx.createOscillator();
        lfo.frequency.value = v.wobble[0];
        const depth = ctx.createGain();
        depth.gain.value = v.wobble[1];
        lfo.connect(depth);
        depth.connect(osc.detune);
        lfo.start(t0);
        lfo.stop(t0 + dur + 0.06);
        extras.push(lfo);
      }
      if (v.breath && noiseBuffer) {
        const src = ctx.createBufferSource();
        src.buffer = noiseBuffer;
        src.loop = true;
        const bp = ctx.createBiquadFilter();
        bp.type = 'bandpass';
        bp.frequency.value = osc.frequency.value * 2;
        bp.Q.value = 1.2;
        const bg = ctx.createGain();
        bg.gain.setValueAtTime(0.0001, t0);
        bg.gain.exponentialRampToValueAtTime(peak * v.breath, t0 + v.attack * 1.6);
        bg.gain.exponentialRampToValueAtTime(0.0001, t0 + dur * 0.7);
        src.connect(bp);
        bp.connect(bg);
        bg.connect(panner);
        src.start(t0);
        src.stop(t0 + dur + 0.06);
        extras.push(src);
      }

      osc.onended = () => {
        voices--;
        panner.disconnect();
        extras.forEach((e) => e.disconnect());
      };
    }

    /** A node and its nearest neighbours, struck together: the graph as a chord. */
    function chordFor(i: number) {
      pluck(i, 0.1, 0.75);
      [...(neighbours.get(nodes[i].id) ?? [])].slice(0, 3).forEach((id, n) => {
        const j = index.get(id);
        if (j !== undefined) pluck(j, 0.045, 0.4, 0.055 * (n + 1));
      });
    }

    /** Retune everything to an area's root; glide, never jump. */
    function setRoot(theme: string | null) {
      root = theme ? (ROOT[theme] ?? 0) : 0;
      if (!actx) return;
      const t = actx.currentTime;
      droneOscs.forEach((osc) => {
        osc.frequency.setTargetAtTime((BASE / 2) * 2 ** (root / 12), t, 0.6);
      });
    }

    function setListening(on: boolean) {
      if (on && !actx) buildAudio();
      if (!actx || !master) return;
      listening = on;
      listenBtn?.setAttribute('aria-pressed', String(on));
      listenBtn?.setAttribute('aria-label', on ? 'Mute the map' : 'Listen to the map');
      if (on) {
        void actx.resume();
        master.gain.cancelScheduledValues(actx.currentTime);
        master.gain.setTargetAtTime(0.34, actx.currentTime, 0.4);
        moveListener();
        start();
      } else {
        // Fade before suspending, or the drone stops with a click.
        master.gain.setTargetAtTime(0, actx.currentTime, 0.15);
        const ctx = actx;
        window.setTimeout(() => {
          if (!listening) void ctx.suspend();
        }, 600);
      }
    }

    const listenBtn = document.getElementById('emap-listen');
    listenBtn?.addEventListener('click', () => setListening(!listening));

    /* ---- the frame ------------------------------------------------------ */
    let raf = 0;
    let last = 0;
    let clock = 0;
    let visible = true;

    function frame(now: number) {
      raf = 0;
      const dt = Math.min(now - last || 16, 48);
      last = now;
      clock += dt;

      const still = reduced.matches;

      // Camera easing. Dragging writes k/tx/ty directly, so this only smooths
      // wheel and focus moves.
      k += (kT - k) * 0.16;
      if (!dragging) {
        tx += (txT - tx) * 0.16 + vx;
        ty += (tyT - ty) * 0.16 + vy;
        txT += vx;
        tyT += vy;
        vx *= 0.9;
        vy *= 0.9;
        if (Math.abs(vx) < 0.01) vx = 0;
        if (Math.abs(vy) < 0.01) vy = 0;
      }

      // Scrubbing eases the data coordinates themselves; reduced motion snaps.
      if (morphing) {
        let worst = 0;
        for (let i = 0; i < pos.length; i++) {
          const d = posT[i] - pos[i];
          worst = Math.max(worst, Math.abs(d));
          pos[i] += still ? d : d * 0.11;
        }
        project();
        if (worst < 0.001) {
          pos.set(posT);
          project();
          morphing = false;
        }
      }

      // The camera is the listener; follow it while it is actually moving.
      if (listening && (Math.abs(kT - k) > 0.001 || Math.abs(txT - tx) > 0.5 || dragging)) {
        moveListener();
      }

      ctx.clearRect(0, 0, w, h);

      const hoveredId = hover >= 0 ? nodes[hover].id : picked >= 0 ? nodes[picked].id : null;
      const near = hoveredId ? neighbours.get(hoveredId) : undefined;

      // --- positions
      for (let i = 0; i < nodes.length; i++) {
        const s = state[i];

        const p = still ? 1 : Math.min(1, Math.max(0, (clock - s.delay) / 900));
        s.appear += (p - s.appear) * 0.25;
        const ease = 1 - Math.pow(1 - s.appear, 3);

        let dx = 0;
        let dy = 0;
        if (!still) {
          dx = Math.sin(clock * s.speed + s.phase) * s.ampX;
          dy = Math.cos(clock * s.speed * 0.82 + s.phase * 1.3) * s.ampY;
        }

        let x = toScreenX(s.bx) + dx;
        let y = toScreenY(s.by) + dy;

        // Cursor makes room for itself. Deliberately small, and switched off for
        // whatever is being hovered: a stronger shove pushes a node out of its
        // own hit radius, and then the map plays keep-away with the pointer
        // instead of letting anyone click it.
        if (pointerIn && !still) {
          const px = x - pointerX;
          const py = y - pointerY;
          const d2 = px * px + py * py;
          const R = 80;
          if (d2 < R * R && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const push = ((R - d) / R) ** 2 * 6 * (1 - s.glow);
            x += (px / d) * push;
            y += (py / d) * push;
          }
        }

        // Entrance: fly in from a ring around the centre.
        if (ease < 1) {
          const cx = w / 2;
          const cy = h / 2;
          const a = s.phase;
          const sx0 = cx + Math.cos(a) * Math.max(w, h) * 0.55;
          const sy0 = cy + Math.sin(a) * Math.max(w, h) * 0.55;
          x = sx0 + (x - sx0) * ease;
          y = sy0 + (y - sy0) * ease;
        }

        s.sx = x;
        s.sy = y;

        // Interaction weights, eased rather than switched.
        const isHot = i === hover || i === picked;
        const isNear = near?.has(nodes[i].id) ?? false;
        const onPath = pathActive && pathNodeSet.has(i);
        const onSearch = searchSet.has(i);
        s.glow += ((isHot ? 1 : 0) - s.glow) * 0.2;
        s.lit += ((isHot || isNear || onPath || onSearch ? 1 : 0) - s.lit) * 0.2;
      }

      // --- edges
      for (let i = 0; i < edges.length; i++) {
        const e = edges[i];
        const ia = index.get(e.s)!;
        const ib = index.get(e.t)!;
        const a = state[ia];
        const b = state[ib];
        if (!a || !b) continue;

        const na = nodes[ia];
        const nb = nodes[ib];
        const show = Math.min(a.appear, b.appear);
        if (show < 0.02) continue;

        const lit = Math.max(
          hoveredId === e.s || hoveredId === e.t ? 1 : 0,
          Math.max(a.glow, b.glow),
        );
        const dim = dimFor(na, ia) * dimFor(nb, ib);

        // While a highlight eases out, hover/picked may already be gone; fall
        // back to the edge's own colour rather than indexing nodes[-1].
        const hot = hover >= 0 ? hover : picked;
        const litColour = (hot >= 0 ? colours.get(nodes[hot].theme) : colours.get(na.theme)) ?? ink.rule;

        // Resting edges take the source node's colour rather than a neutral grey:
        // at this alpha it reads as a faint coloured web instead of disappearing
        // into the background, which is what a dark-on-dark grey line does.
        const base = colours.get(na.theme) ?? ink.rule;

        // A traced path is the one moment the map argues a single line of
        // thought; everything else steps far back.
        const onPath = pathEdgeSet.has(i);
        ctx.globalAlpha = onPath ? show * 0.9 : show * dim * (0.2 + lit * 0.62);
        ctx.strokeStyle = onPath ? ink.accent : lit > 0.05 ? litColour : base;
        ctx.lineWidth = onPath ? 1.8 : 1 + lit * 0.8;
        curve(a.sx, a.sy, b.sx, b.sy, i);
        ctx.stroke();
      }

      // --- pulses: a signal walking the graph, one hop per beat
      nextPulse -= dt;
      if (nextPulse <= 0 && edges.length) {
        const hop = nextHop();
        if (hop !== null) {
          // One beat per hop, so arrivals land on the grid and the ambient
          // layer is a rhythm rather than a sprinkle.
          if (!still) pulses.push({ edge: hop.edge, p: 0, speed: 1 / BEAT, rev: hop.rev });
          else if (listening) pluck(hop.to, 0.055, 0.55); // no pulses to ride
        }
        nextPulse = BEAT;
      }

      if (!still) {
        for (let i = pulses.length - 1; i >= 0; i--) {
          const pulse = pulses[i];
          pulse.p += pulse.speed * dt;
          if (pulse.p >= 1) {
            // The pulse lands: its destination is the note.
            const done = edges[pulse.edge];
            const to = index.get(pulse.rev ? done.s : done.t)!;
            pluck(to, pathEdgeSet.has(pulse.edge) ? 0.1 : 0.055, 0.3 + done.w * 0.7);
            pulses.splice(i, 1);
            continue;
          }
          if (pulse.p < 0) continue;
          const e = edges[pulse.edge];
          const ia = index.get(e.s)!;
          const a = state[ia];
          const b = state[index.get(e.t)!];
          if (!a || !b) continue;
          const na = nodes[ia];
          const t = pulse.rev ? 1 - pulse.p : pulse.p;
          const [px, py] = along(a.sx, a.sy, b.sx, b.sy, pulse.edge, t);
          const fade = Math.sin(pulse.p * Math.PI);
          const onPath = pathEdgeSet.has(pulse.edge);
          ctx.globalAlpha = fade * 0.75 * (onPath ? 1 : dimFor(na, ia));
          ctx.fillStyle = onPath ? ink.accent : (colours.get(na.theme) ?? ink.accent);
          ctx.beginPath();
          ctx.arc(px, py, onPath ? 2.3 : 1.9, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // --- nodes
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        const s = state[i];
        if (s.appear < 0.02) continue;

        const colour = colours.get(n.theme) ?? ink.accent;
        const alpha =
          s.appear * dimFor(n, i) * (hoveredId && !pathActive ? 0.42 + s.lit * 0.58 : 1);
        const r = (s.r + s.glow * 2.6) * Math.min(k, 1.6);

        // halo
        const size = (r + 9 + s.glow * 16) * 2;
        ctx.globalAlpha = alpha * (0.42 + s.glow * 0.58);
        ctx.drawImage(halo(colour), s.sx - size / 2, s.sy - size / 2, size, size);

        // core
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(s.sx, s.sy, r, 0, Math.PI * 2);
        ctx.fillStyle = colour;
        ctx.globalAlpha = alpha * (0.25 + s.lit * 0.75);
        ctx.fill();
        ctx.globalAlpha = alpha;
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = colour;
        ctx.stroke();

        // label: on demand, along a traced path, or everywhere once zoomed in
        const wantLabel = Math.max(
          s.glow,
          pathActive && pathNodeSet.has(i) ? 0.85 : 0,
          k > 1.7 ? Math.min(1, (k - 1.7) * 1.6) : 0,
        );
        if (wantLabel > 0.03) {
          ctx.globalAlpha = alpha * wantLabel;
          ctx.fillStyle = s.glow > 0.4 ? ink.fg : ink.dim;
          ctx.font = `${11 + s.glow * 1.5}px ${fontFamily}`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'top';
          ctx.fillText(n.short, s.sx, s.sy + r + 6);
        }
      }

      ctx.globalAlpha = 1;

      if (visible) raf = requestAnimationFrame(frame);
    }

    /** Dim anything outside the traced path, search results or filter — never hide. */
    function dimFor(n: Node, i: number) {
      if (pathActive) return pathNodeSet.has(i) ? 1 : 0.1;
      if (searchSet.size) return searchSet.has(i) ? 1 : 0.15;
      return filter === 'all' || n.theme === filter ? 1 : 0.12;
    }

    /** A slight arc reads as a network; straight lines read as a chart. */
    function bend(ax: number, ay: number, bx: number, by: number, seed: number) {
      const mx = (ax + bx) / 2;
      const my = (ay + by) / 2;
      const dx = bx - ax;
      const dy = by - ay;
      const side = seed % 2 ? 0.08 : -0.08;
      return [mx - dy * side, my + dx * side] as const;
    }

    function curve(ax: number, ay: number, bx: number, by: number, seed: number) {
      const [cx, cy] = bend(ax, ay, bx, by, seed);
      ctx.beginPath();
      ctx.moveTo(ax, ay);
      ctx.quadraticCurveTo(cx, cy, bx, by);
    }

    function along(ax: number, ay: number, bx: number, by: number, seed: number, t: number) {
      const [cx, cy] = bend(ax, ay, bx, by, seed);
      const u = 1 - t;
      return [
        u * u * ax + 2 * u * t * cx + t * t * bx,
        u * u * ay + 2 * u * t * cy + t * t * by,
      ] as const;
    }

    function start() {
      if (!raf && visible) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    }

    /* ---- sizing ---------------------------------------------------------- */
    function resize() {
      const rect = canvas!.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      layout();
    }

    /* ---- picking --------------------------------------------------------- */
    function pick(mx: number, my: number) {
      let best = -1;
      let bestDist = 21 * 21;
      for (let i = 0; i < nodes.length; i++) {
        if (filter !== 'all' && nodes[i].theme !== filter) continue;
        const dx = state[i].sx - mx;
        const dy = state[i].sy - my;
        const d = dx * dx + dy * dy;
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      }
      return best;
    }

    function showTip(i: number, mx: number, my: number) {
      const n = nodes[i];
      tip!.style.setProperty('--tip-accent', colours.get(n.theme) ?? ink.accent);
      tip!.querySelector('strong')!.textContent = n.title;
      tip!.querySelector('span')!.textContent = [n.kind, n.year, n.venue].filter(Boolean).join(' · ');
      tip!.hidden = false;
      const box = tip!.getBoundingClientRect();
      tip!.style.left = `${Math.max(4, Math.min(mx + 16, w - box.width - 8))}px`;
      tip!.style.top = `${Math.max(4, Math.min(my + 16, h - box.height - 8))}px`;
    }

    const walkBtn = card.querySelector<HTMLButtonElement>('.card-walk')!;

    function openCard(i: number) {
      clearPath();
      walkBtn.hidden = false;
      const n = nodes[i];
      picked = i;
      const colour = colours.get(n.theme) ?? ink.accent;
      card!.style.setProperty('--card-accent', colour);
      card!.querySelector('.card-kind')!.textContent = n.kind;
      card!.querySelector('.card-title')!.textContent = n.title;
      card!.querySelector('.card-meta')!.textContent = [n.year, n.venue].filter(Boolean).join(' · ');
      const link = card!.querySelector<HTMLAnchorElement>('.card-link')!;
      link.href = n.url.startsWith('/news/#') ? n.url.toLowerCase() : n.url;
      card!.hidden = false;
      chordFor(i);

      // Ease the camera so the chosen node is centred and a little closer in.
      kT = Math.max(k, 1.55);
      txT = w / 2 - state[i].bx * kT;
      tyT = h / 2 - state[i].by * kT;
      vx = vy = 0;
    }

    function closeCard() {
      clearPath();
      walkBtn.hidden = false;
      picked = -1;
      card!.hidden = true;
    }

    /* ---- tracing a walk -------------------------------------------------- */
    walkBtn.addEventListener('click', () => {
      if (picked < 0) return;
      walkArmed = true;
      walkBtn.hidden = true;
      card!.querySelector('.card-kind')!.textContent = 'latent walk';
      card!.querySelector('.card-meta')!.textContent =
        'now click any other node to trace the closest chain of works';
    });

    function buildPath(from: number, to: number) {
      walkArmed = false;
      const path = shortestPath(nodes[from].id, nodes[to].id);
      const kindEl = card!.querySelector('.card-kind')!;
      const titleEl = card!.querySelector('.card-title')!;
      const metaEl = card!.querySelector('.card-meta')!;
      kindEl.textContent = 'latent walk';
      titleEl.textContent = `${nodes[from].short} → ${nodes[to].short}`;

      if (!path) {
        // The kNN graph is not guaranteed connected; say so instead of nothing.
        metaEl.textContent = 'no chain of similarity links joins these two';
        walkBtn.hidden = false;
        return;
      }

      pathActive = true;
      pathNodeSet.clear();
      path.forEach((i) => pathNodeSet.add(i));
      pathEdgeSet.clear();
      for (let k2 = 0; k2 < path.length - 1; k2++) {
        const idx = edgeAt.get(`${nodes[path[k2]].id}|${nodes[path[k2 + 1]].id}`)!;
        pathEdgeSet.add(idx);
        // A staggered cascade of pulses runs the route, so direction is legible.
        pulses.push({
          edge: idx,
          p: -k2 * 0.5,
          speed: 0.0009,
          rev: edges[idx].s !== nodes[path[k2]].id,
        });
      }

      const hops = path.length - 1;
      metaEl.textContent = `${hops} ${hops === 1 ? 'hop' : 'hops'} · ${path.map((i) => nodes[i].short).join(' → ')}`;
      const link = card!.querySelector<HTMLAnchorElement>('.card-link')!;
      const url = nodes[to].url;
      link.href = url.startsWith('/news/#') ? url.toLowerCase() : url;
      walkBtn.hidden = true;
      card!.hidden = false;

      frameNodes(path);
      // The route as a phrase, a note every half beat. Each note's brightness
      // is its link's similarity, so a tight chain sounds clearer than a stretch.
      path.forEach((n, step) => {
        const w2 = step === 0 ? 0.9 : edges[edgeAt.get(`${nodes[path[step - 1]].id}|${nodes[n].id}`)!].w;
        pluck(n, 0.11, 0.25 + w2 * 0.75, (step * BEAT) / 2000);
      });
    }

    /* ---- pointer --------------------------------------------------------- */
    let lastX = 0;
    let lastY = 0;
    let moved = 0;

    canvas.addEventListener('pointerdown', (event) => {
      dragging = true;
      moved = 0;
      lastX = event.clientX;
      lastY = event.clientY;
      canvas!.setPointerCapture(event.pointerId);
      canvas!.classList.add('dragging');
      tip!.hidden = true;
      hint?.setAttribute('data-gone', '');
      vx = vy = 0;
    });

    canvas.addEventListener('pointermove', (event) => {
      const rect = canvas!.getBoundingClientRect();
      pointerX = event.clientX - rect.left;
      pointerY = event.clientY - rect.top;
      pointerIn = true;

      if (dragging) {
        const dx = event.clientX - lastX;
        const dy = event.clientY - lastY;
        tx += dx;
        ty += dy;
        txT = tx;
        tyT = ty;
        vx = dx * 0.35;
        vy = dy * 0.35;
        lastX = event.clientX;
        lastY = event.clientY;
        moved += Math.abs(dx) + Math.abs(dy);
        return;
      }

      const hit = pick(pointerX, pointerY);
      if (hit !== hover) {
        hover = hit;
        canvas!.classList.toggle('over', hit >= 0);
        if (hit < 0) tip!.hidden = true;
        // Brushing across the constellation plays it like an instrument.
        if (hit >= 0) pluck(hit, 0.07, 0.55);
      }
      if (hit >= 0) showTip(hit, pointerX, pointerY);
    });

    const release = () => {
      dragging = false;
      canvas!.classList.remove('dragging');
    };

    canvas.addEventListener('pointerup', (event) => {
      release();
      // A drag is not a click. 5px of slop covers a shaky hand.
      if (moved < 6) {
        const rect = canvas!.getBoundingClientRect();
        const hit = pick(event.clientX - rect.left, event.clientY - rect.top);
        if (walkArmed && picked >= 0 && hit >= 0 && hit !== picked) {
          buildPath(picked, hit);
        } else if (walkArmed && picked >= 0) {
          // Clicked away while picking a destination: restore the plain card.
          openCard(picked);
        } else if (hit >= 0) {
          openCard(hit);
        } else {
          closeCard();
        }
      }
    });

    canvas.addEventListener('pointercancel', release);

    canvas.addEventListener('pointerleave', () => {
      pointerIn = false;
      pointerX = pointerY = -1e6;
      hover = -1;
      tip!.hidden = true;
      canvas!.classList.remove('over');
    });

    canvas.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();
        const rect = canvas!.getBoundingClientRect();
        const mx = event.clientX - rect.left;
        const my = event.clientY - rect.top;
        const next = Math.min(6, Math.max(0.55, kT * Math.exp(-event.deltaY * 0.0014)));
        const ratio = next / kT;
        txT = mx - (mx - txT) * ratio;
        tyT = my - (my - tyT) * ratio;
        kT = next;
        hint?.setAttribute('data-gone', '');
      },
      { passive: false },
    );

    canvas.addEventListener('dblclick', reset);

    function reset() {
      kT = 1;
      txT = 0;
      tyT = 0;
      vx = vy = 0;
      closeCard();
    }

    /** Ease the camera until the given nodes fill the stage. */
    function frameNodes(picks: number[]) {
      if (!picks.length) return reset();

      let x0 = Infinity;
      let y0 = Infinity;
      let x1 = -Infinity;
      let y1 = -Infinity;
      for (const i of picks) {
        x0 = Math.min(x0, state[i].bx);
        y0 = Math.min(y0, state[i].by);
        x1 = Math.max(x1, state[i].bx);
        y1 = Math.max(y1, state[i].by);
      }

      const pad = 90;
      kT = Math.min(Math.max((w - pad * 2) / Math.max(x1 - x0, 1), 0.6), 2.6);
      kT = Math.min(kT, Math.max((h - pad * 2) / Math.max(y1 - y0, 1), 0.6));
      txT = w / 2 - ((x0 + x1) / 2) * kT;
      tyT = h / 2 - ((y0 + y1) / 2) * kT;
      vx = vy = 0;
    }

    card.querySelector('.card-close')!.addEventListener('click', () => {
      closeCard();
      reset();
    });

    /* ---- legend ----------------------------------------------------------- */
    figure.querySelectorAll<HTMLButtonElement>('.key').forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.filter!;
        filter = filter === value ? 'all' : value;

        figure.querySelectorAll<HTMLButtonElement>('.key').forEach((other) => {
          other.setAttribute('aria-pressed', String(other.dataset.filter === filter));
        });

        // Mirror the filter onto the server-rendered list, so the buttons do
        // something for anyone who is not looking at the canvas.
        if (filter === 'all') {
          figure.removeAttribute('data-filter');
          figure.querySelectorAll<HTMLElement>('.fallback section').forEach((s) => {
            s.style.display = '';
          });
        } else {
          figure.setAttribute('data-filter', filter);
          figure.querySelectorAll<HTMLElement>('.fallback section').forEach((s) => {
            s.style.display = s.dataset.themeSection === filter ? 'block' : '';
          });
        }

        closeCard();
        clearSearch();
        hint?.setAttribute('data-gone', '');
        // Choosing an area is also a modal shift: the map retunes to its root
        // and the walker restarts inside it.
        setRoot(filter === 'all' ? null : filter);
        walker = -1;

        // Choosing an area flies the camera to it. Leaving the view wherever it
        // happened to be would often frame nothing at all.
        if (filter === 'all') reset();
        else frameNodes(nodes.map((n, i) => (n.theme === filter ? i : -1)).filter((i) => i >= 0));
      });
    });

    /* ---- projection scrubber --------------------------------------------- */
    const variantInput = document.getElementById('emap-variant') as HTMLInputElement | null;
    const variantOut = document.getElementById('emap-variant-out');

    function describeVariant(v: Variant) {
      const s = typeof v.silhouette === 'number' ? v.silhouette.toFixed(2) : 'n/a';
      return `seed ${v.seed} · k ${v.k} · silhouette ${s}${v.canonical ? ' · shipped' : ''}`;
    }

    function applyVariant(i: number) {
      const v = variants?.[i];
      if (!v || v.xy.length !== nodes.length) return;
      for (let n = 0; n < nodes.length; n++) {
        posT[n * 2] = v.xy[n][0];
        posT[n * 2 + 1] = v.xy[n][1];
      }
      morphing = true;
      // The floor lifts while the projection is unsettled, then settles with it.
      if (actx && droneFilter && listening) {
        droneFilter.frequency.setTargetAtTime(620, actx.currentTime, 0.15);
        droneFilter.frequency.setTargetAtTime(300, actx.currentTime + 1.2, 0.8);
      }
      if (variantOut) variantOut.textContent = describeVariant(v);
      variantInput?.setAttribute('aria-valuetext', describeVariant(v));
      start();
    }

    variantInput?.addEventListener('input', () => applyVariant(Number(variantInput.value)));
    // Seed the readout; the targets equal the current positions, so nothing moves.
    if (variantInput) applyVariant(0);

    /* ---- semantic search --------------------------------------------------
     * Everything happens on this machine: the int8 document vectors were baked
     * at build time, the query encoder is a ~23 MB quantised MiniLM fetched
     * only when the visitor asks for it, and ranking is 42 dot products.
     */
    const searchLoad = document.getElementById('emap-search-load') as HTMLButtonElement | null;
    const searchLive = document.getElementById('emap-search-live');
    const searchInput = document.getElementById('emap-search-input') as HTMLInputElement | null;
    const searchResults = document.getElementById('emap-search-results');
    const searchStatus = document.getElementById('emap-search-status');

    let searchIds: string[] = [];
    let docVectors: Float32Array | null = null;
    let dims = 0;
    let embedQuery: ((q: string) => Promise<Float32Array>) | null = null;
    let searchSet = new Set<number>();
    let searchTimer = 0;
    let searchSeq = 0;

    function setStatus(text: string | null) {
      if (!searchStatus) return;
      searchStatus.hidden = !text;
      searchStatus.textContent = text ?? '';
    }

    function clearSearch() {
      searchSet = new Set();
      if (searchResults) searchResults.innerHTML = '';
    }

    async function loadSearch() {
      if (!searchLoad) return;
      searchLoad.disabled = true;
      try {
        setStatus('fetching the index…');
        const res = await fetch('/search-index.json');
        if (!res.ok) throw new Error(`index HTTP ${res.status}`);
        const idx = (await res.json()) as {
          dims: number;
          ids: string[];
          scales: number[];
          vectors: string;
        };
        dims = idx.dims;
        searchIds = idx.ids;
        const raw = atob(idx.vectors);
        docVectors = new Float32Array(raw.length);
        for (let r = 0; r < idx.ids.length; r++) {
          const scale = idx.scales[r] / 127;
          for (let c = 0; c < dims; c++) {
            const byte = raw.charCodeAt(r * dims + c);
            docVectors[r * dims + c] = (byte > 127 ? byte - 256 : byte) * scale;
          }
        }

        setStatus('loading the encoder — a one-off download, cached by the browser…');
        const { pipeline } = await import('@huggingface/transformers');
        const extract = await pipeline('feature-extraction', 'Xenova/all-MiniLM-L6-v2', {
          dtype: 'q8',
          progress_callback: (p: { status?: string; progress?: number; file?: string }) => {
            if (p.status === 'progress' && p.file?.endsWith('.onnx'))
              setStatus(`downloading the encoder — ${Math.round(p.progress ?? 0)}%`);
          },
        });
        embedQuery = async (q: string) => {
          const out = await extract(q, { pooling: 'mean', normalize: true });
          return out.data as Float32Array;
        };

        setStatus(null);
        searchLoad.hidden = true;
        if (searchLive) searchLive.hidden = false;
        searchInput?.focus();
      } catch (error) {
        setStatus(`could not load (${(error as Error).message}) — press the button to retry`);
        searchLoad.disabled = false;
      }
    }

    async function runSearch(query: string) {
      if (!embedQuery || !docVectors || !searchResults) return;
      const q = query.trim();
      if (q.length < 3) {
        clearSearch();
        return;
      }
      const seq = ++searchSeq;
      const v = await embedQuery(q);
      if (seq !== searchSeq) return; // a newer keystroke superseded this run

      const scored = searchIds
        .map((id, r) => {
          let dot = 0;
          for (let c = 0; c < dims; c++) dot += v[c] * docVectors![r * dims + c];
          return { id, score: dot };
        })
        .sort((a, b) => b.score - a.score)
        .slice(0, 5)
        .filter((s) => s.score > 0.18 && index.has(s.id));

      searchResults.innerHTML = '';
      searchSet = new Set(scored.map((s) => index.get(s.id)!));

      if (!scored.length) {
        const li = document.createElement('li');
        li.className = 'r-none';
        li.textContent = 'nothing close — try different words';
        searchResults.append(li);
        start();
        return;
      }

      for (const s of scored) {
        const i = index.get(s.id)!;
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        const title = document.createElement('span');
        title.textContent = nodes[i].short;
        const num = document.createElement('span');
        num.className = 'r-num';
        num.textContent = s.score.toFixed(2);
        btn.append(title, num);
        btn.addEventListener('click', () => openCard(i));
        li.append(btn);
        searchResults.append(li);
      }
      frameNodes([...searchSet]);
      start();
    }

    searchLoad?.addEventListener('click', () => void loadSearch());
    searchInput?.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => void runSearch(searchInput.value), 250);
    });

    /* ---- full-screen app and help ------------------------------------------ */
    const fullBtn = document.getElementById('emap-full');
    const helpBtn = document.getElementById('emap-help');
    const helpDialog = document.getElementById('emap-dialog') as HTMLDialogElement | null;
    const helpFull = document.getElementById('emap-open-full');

    function setFull(on: boolean) {
      figure!.classList.toggle('is-full', on);
      // The page behind the overlay must not scroll out from under it.
      document.documentElement.classList.toggle('emap-lock', on);
      fullBtn?.setAttribute('aria-pressed', String(on));
      fullBtn?.setAttribute(
        'aria-label',
        on ? 'Exit the full-screen map' : 'Open the map full screen',
      );
      // The ResizeObserver refits the canvas; just make sure the loop is awake.
      start();
    }

    fullBtn?.addEventListener('click', () => setFull(!figure!.classList.contains('is-full')));

    document.addEventListener('keydown', (event) => {
      // The dialog handles its own Escape (and swallows focus while open):
      // only a bare Escape in app mode should exit it.
      if (
        event.key === 'Escape' &&
        figure!.classList.contains('is-full') &&
        !helpDialog?.open &&
        // (`Element`, not `Node`: this file's map-node interface shadows DOM Node.)
        !(helpDialog && helpDialog.contains(event.target as Element))
      ) {
        setFull(false);
      }
    });

    helpBtn?.addEventListener('click', () => helpDialog?.showModal());
    helpDialog?.querySelector('.help-close')?.addEventListener('click', () => helpDialog.close());
    // A click on the backdrop lands on the dialog element itself.
    helpDialog?.addEventListener('click', (event) => {
      if (event.target === helpDialog) helpDialog.close();
    });
    helpFull?.addEventListener('click', () => {
      helpDialog?.close();
      setFull(true);
    });

    /* ---- keyboard users tab the list; focusing an entry lights its node ---- */
    list?.addEventListener('focusin', (event) => {
      const id = (event.target as HTMLElement)?.dataset?.node;
      if (!id) return;
      const i = index.get(id);
      if (i !== undefined) hover = i;
    });

    list?.addEventListener('focusout', () => {
      hover = -1;
    });

    /* ---- lifecycle --------------------------------------------------------- */
    new ResizeObserver(resize).observe(canvas);

    // Off-screen or backgrounded, the loop stops dead: no idle CPU burn.
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting && !document.hidden;
        if (visible) start();
        else if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
        // Scrolled away, the drone would otherwise hum on under the CV page.
        if (actx && listening) {
          if (visible) void actx.resume();
          else void actx.suspend();
        }
      },
      { threshold: 0.01 },
    ).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
      if (visible) start();
      else if (raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
      // A backgrounded tab must fall silent, and come back only if it was on.
      if (actx) {
        if (document.hidden) void actx.suspend();
        else if (listening) void actx.resume();
      }
    });

    new MutationObserver(readPalette).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    reduced.addEventListener('change', start);

    readPalette();
    resize();
    start();
  }
</script>
