---
import map from '@/data/viz/embedding-map.json';
import variantData from '@/data/viz/map-variants.json';

/**
 * The research corpus as a living constellation.
 *
 * Canvas 2D, no library. The layout is precomputed in Python, so a plotting
 * library would only be supplying a scale and a zoom behaviour — a single affine
 * transform, in a few lines. What the budget is spent on instead is motion:
 * everything eases, nothing snaps, and the map keeps breathing when idle so that
 * it reads as something to touch rather than a picture of a graph.
 *
 * Positions come from the embedding; colours come from declared research themes.
 * Colouring by a clustering run over 36 documents would invent structure that the
 * sanity numbers say is not there.
 */
const { nodes, edges, themes, sanity } = map;

/**
 * The scrubber tweens node positions by array index, so a variants file built
 * against a different corpus would silently shuffle 42 works around the map.
 * The CI guard compares source hashes; this catches the same drift at build.
 */
if (
  variantData.ids.length !== nodes.length ||
  variantData.ids.some((id, i) => id !== nodes[i].id)
) {
  throw new Error(
    'map-variants.json disagrees with embedding-map.json — run scripts/build_map_variants.py',
  );
}
const variants = variantData.variants;

const num = (v: unknown, digits = 2) => (typeof v === 'number' ? v.toFixed(digits) : 'n/a');

/**
 * How well the declared areas hold up, in words, derived rather than asserted.
 *
 * This number moves every time the embedding is rebuilt — it has already gone
 * from slightly negative to +0.30 as papers were added — so a hand-written
 * reading of it silently becomes a lie. Say what the current value means.
 */
function separation(s: unknown) {
  if (typeof s !== 'number') return 'are hard to score';
  if (s < 0.05) return 'do not separate at all';
  if (s < 0.25) return 'barely separate';
  if (s < 0.5) return 'separate only weakly';
  return 'separate cleanly';
}

/** Theme colours resolve through the palette so they follow the light/dark switch. */
const TOKEN: Record<string, string> = {
  'cultural-heritage': 'heritage',
  multimodal: 'multimodal',
  'symbolic-music': 'symbolic',
  'dsp-tooling': 'dsp',
  musicology: 'musicology',
  engineering: 'engineering',
};

const byTheme = themes
  .map((t) => ({ ...t, items: nodes.filter((n) => n.theme === t.id) }))
  .filter((t) => t.items.length > 0);

const palette = byTheme
  .map((t) => `--c-${t.id}: var(--theme-${TOKEN[t.id] ?? 'dsp'}, ${t.color})`)
  .join(';');

/** Phone-width legend labels: six full ones stack into a quarter of the screen. */
const SHORT: Record<string, string> = {
  'cultural-heritage': 'heritage',
  multimodal: 'multimodal',
  'symbolic-music': 'symbolic',
  'dsp-tooling': 'DSP',
  musicology: 'musicology',
  engineering: 'engineering',
};

const KIND_LABEL: Record<string, string> = {
  paper: 'paper',
  post: 'post',
  project: 'project',
  news: 'news',
};

const count = (kind: string) => nodes.filter((n) => n.kind === kind).length;

/**
 * The stage takes the projection's own proportions.
 *
 * The layout scales uniformly — it has to, or the distances stop meaning
 * anything — so a frame whose shape disagrees with the data's is padding.
 * A hardcoded 16/9 against this constellation left over half the box empty,
 * and re-running the embedding changes the extent, so it is measured here
 * rather than guessed. Clamped in case a future run comes out extreme.
 */
const xs = nodes.map((n) => n.x);
const ys = nodes.map((n) => n.y);
const spanX = Math.max(...xs) - Math.min(...xs) || 1;
const spanY = Math.max(...ys) - Math.min(...ys) || 1;
const aspect = Math.min(2.4, Math.max(0.8, spanX / spanY));

/** Height first: the figure is then only as wide as that shape needs. */
const shape = `--aspect: ${aspect.toFixed(3)}`;
---

<figure class="map" data-emap style={`${palette};${shape}`}>
  <div class="rail">
    {/* Only rendered useful in the full-screen app; the landing stays quiet. */}
    <div class="app-intro">
      <p class="app-title">## corpus explorer</p>
      <p>
        Everything I have written, placed by how similar the texts are. Click a node for its card,
        trace paths between works, search the corpus in plain words, turn on the sound to hear the
        map from wherever the camera stands — and drag the projection slider to see how much of this
        picture is real structure.
      </p>
    </div>

    <div class="legend" role="group" aria-label="Highlight one research area">
    <button type="button" class="key key--all" data-filter="all" aria-pressed="true">
      all {nodes.length}
    </button>
    {
      byTheme.map((t) => (
        <button
          type="button"
          class="key"
          data-filter={t.id}
          aria-pressed="false"
          style={`--c: var(--c-${t.id})`}
        >
          <span class="swatch" />
          {/* Only one of these is ever displayed, so the accessible name stays
              a single label rather than both concatenated. */}
          <span class="full">{t.label}</span>
          <span class="abbr">{SHORT[t.id] ?? t.label}</span>
          <span class="n">{t.items.length}</span>
        </button>
      ))
    }
  </div>

  {/* JS-only controls; everything here is an enhancement over the canvas. */}
  <div class="tools">
    {/*
      Search runs entirely in the visitor's browser: a ~23 MB quantised
      encoder behind an explicit gate, ranking against int8 vectors baked at
      build time. The gate is the disclosure — nothing downloads until asked.
    */}
    <div class="search">
      <p class="search-title" id="emap-search-title">search the corpus</p>
      <button type="button" id="emap-search-load" class="tool-btn">
        ⇣ load semantic search · ~23 MB
      </button>
      <p class="search-fine">
        an encoder runs in your browser — nothing you type leaves this page. English works best.
      </p>
      <div class="search-live" id="emap-search-live" hidden>
        <input
          type="search"
          id="emap-search-input"
          placeholder="try: restoring damaged tape recordings"
          aria-labelledby="emap-search-title"
          autocomplete="off"
        />
        <ol class="search-results" id="emap-search-results"></ol>
      </div>
      <p class="search-status" id="emap-search-status" role="status" hidden></p>
    </div>

    {/*
      The caveat, made scrubbable: the same embedding refitted under other
      seeds and neighbourhood sizes. Watching the picture change while the
      neighbourhoods hold is the argument for reading the geometry loosely.
    */}
    <div class="variant">
      <label for="emap-variant">same data, other projections</label>
      <input
        type="range"
        id="emap-variant"
        min="0"
        max={variants.length - 1}
        value="0"
        step="1"
      />
      <output id="emap-variant-out" for="emap-variant"></output>
    </div>
  </div>
  </div>

  <div class="stage">
    {/* The frame's own chrome: expand to the full-screen app, or ask what it is. */}
    <div class="corner">
      {/* Sound sits beside the frame controls, reachable without entering the
          app, so starting and stopping it is always one click from the map. */}
      <button
        type="button"
        id="emap-listen"
        class="icon-btn"
        aria-pressed="false"
        aria-label="Listen to the map"
      >
        <svg class="snd-off" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h2.5L9 3v10L5.5 10H3z"></path>
        </svg>
        <svg class="snd-on" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h2.5L9 3v10L5.5 10H3z"></path>
          <path d="M11.2 5.6a3.4 3.4 0 0 1 0 4.8M13.2 3.6a6.2 6.2 0 0 1 0 8.8" stroke-linecap="round"></path>
        </svg>
      </button>
      <button
        type="button"
        id="emap-full"
        class="icon-btn"
        aria-pressed="false"
        aria-label="Open the map full screen"
      >
        <span class="exp" aria-hidden="true">
          <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 1H1v4M9 1h4v4M5 13H1V9M9 13h4V9"></path>
          </svg>
        </span>
        <span class="cls" aria-hidden="true">×</span>
      </button>
      <button type="button" id="emap-help" class="icon-btn" aria-label="What is this map?">
        ?
      </button>
    </div>

    <canvas id="emap" aria-hidden="true"></canvas>

    <div id="emap-tip" class="tip" aria-hidden="true" hidden>
      <strong></strong><span></span>
    </div>

    <aside id="emap-card" class="card" hidden>
      <p class="card-kind"></p>
      <h3 class="card-title"></h3>
      <p class="card-meta"></p>
      <a class="card-link" href="/">open</a>
      <button type="button" class="card-walk">⌁ trace a path from here</button>
      <button type="button" class="card-close" aria-label="Close">×</button>
    </aside>

    <p class="hint" id="emap-hint" aria-hidden="true">
      <span class="fine">drag to pan · scroll to zoom · click a node</span>
      <span class="coarse">drag to pan · tap a node</span>
    </p>
  </div>

  <figcaption>
    {count('paper')} papers, {count('project')} projects, {count('post')} posts and{' '}
    {count('news')} news, placed by how similar their text is.
  </figcaption>

  {/*
    Everything the inline note used to say, one click away instead of always on
    screen. A native dialog: focus trap, Escape and the top layer come free,
    and the text still ships in every page's HTML for whoever reads source.
  */}
  <dialog id="emap-dialog" class="help" aria-labelledby="emap-help-title">
    <div class="help-head">
      <p class="help-title" id="emap-help-title">## the research map</p>
      <button type="button" class="help-close" aria-label="Close">×</button>
    </div>
    <div class="help-body">
      <p>
        Everything I have written — {count('paper')} papers, {count('project')} projects,{' '}
        {count('post')} posts, {count('news')} news — embedded with {map.model} over{' '}
        {sanity.chunks} text chunks and projected to two dimensions with UMAP. Distance is textual
        similarity; the lines join each work's closest neighbours; colour is my declared research
        area, never a clustering of the embedding.
      </p>
      <p>
        <strong>Here:</strong> drag to pan, scroll to zoom, click a node for its card — and from a
        card, trace the shortest chain of similarity links to any other work.
      </p>
      <p>
        <strong>Sound</strong> (the speaker) plays the map rather than decorating it. The camera is
        the listener: pan and zoom move you across and above the constellation, so what you are
        looking at is what you hear nearby. A signal walks the similarity graph, one note a second,
        and each research area has its own instrument — tape flutter for the heritage work, a
        plucked string for the Baroque scores, a reed for musicology. Opening a work sounds it with
        its nearest neighbours; a traced path plays as a phrase.
      </p>
      <p>
        <strong>Full screen</strong> turns the map into a small app: semantic search that runs
        entirely in your browser, and a slider across {variants.length} alternative projections of
        the same embedding.
      </p>
      <p>
        <strong>Read the geometry loosely.</strong> The areas{' '}
        {separation(sanity.silhouetteVsThemes)} here — silhouette{' '}
        {num(sanity.silhouetteVsThemes)} in this picture, {num(sanity.silhouetteVsThemesEmbedding)}{' '}
        in the full embedding — because nearly everything is audio, music and machine learning
        (within-area similarity {num(sanity.meanIntraTheme)}, between-area{' '}
        {num(sanity.meanInterTheme)}). The lines are computed in the embedding rather than in the
        picture, so who connects to whom means more than how far apart things sit.
      </p>
      <button type="button" id="emap-open-full" class="tool-btn">⤢ open the full app</button>
    </div>
  </dialog>

  {/*
    Always server-rendered. Visually hidden once the canvas is live, but it stays
    in the DOM and the accessibility tree — so screen readers, keyboard users,
    no-JS visitors and crawlers all get the full contents. The legend filters it
    too, so those buttons do something for everyone.
  */}
  <div class="fallback" id="emap-list">
    {
      byTheme.map((t) => (
        <section data-theme-section={t.id}>
          <h3 style={`--c: var(--c-${t.id})`}>{t.label}</h3>
          <ul>
            {t.items.map((n) => (
              <li>
                {/* Astro lowercases collection ids, so the news anchors the build
                    script derived from filenames must be folded too. */}
                <a href={n.url.startsWith('/news/#') ? n.url.toLowerCase() : n.url} data-node={n.id}>
                  {n.title}
                </a>
                <span class="meta">
                  {KIND_LABEL[n.kind] ?? n.kind}
                  {n.year ? ` · ${n.year}` : ''}
                  {n.venue ? ` · ${n.venue}` : ''}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <script
    type="application/json"
    id="emap-data"
    is:inline
    set:html={JSON.stringify({ nodes, edges, themes, variants })}
  />
</figure>

<style>
  .map {
    margin: 0;
    /* Legend, stage and caption share the stage's width, so the figure reads as
       one block instead of a wide legend stranded above a narrow map. */
    --stage-height: 38rem;
    max-width: min(100%, calc(var(--stage-height) * var(--aspect)));
    /* The halo sprites are additive light: right on a dark ground, a grey
       smudge on a light one. The script reads this before drawing. */
    --halo-alpha: 0.55;
  }

  :global([data-theme='light']) .map {
    --halo-alpha: 0.14;
  }

  /*
   * Desktop composition: the rail (legend, and in the app the tools) stands
   * beside the stage instead of stacking above and below it — the right half
   * of the page is not empty, and the stage's top edge clears a 768px fold.
   * JS-gated because without the canvas the stacked flow reads better.
   */
  @media (min-width: 1100px) {
    :global(html.js) .map:not(.is-full) {
      display: grid;
      grid-template-columns: minmax(0, calc(var(--stage-height) * var(--aspect))) minmax(
          15rem,
          19rem
        );
      grid-template-rows: auto auto 1fr;
      column-gap: 2.5rem;
      align-items: start;
      max-width: none;
    }

    :global(html.js) .map:not(.is-full) > .stage {
      grid-column: 1;
      grid-row: 1 / 4;
    }

    :global(html.js) .map:not(.is-full) > .rail {
      grid-column: 2;
      grid-row: 1;
    }

    :global(html.js) .map:not(.is-full) > figcaption {
      grid-column: 2;
      grid-row: 2;
      margin-block-start: 1rem;
    }

    /* Normally clipped to a 1px box; when focus brings it back, span the figure. */
    :global(html.js) .map:not(.is-full) > .fallback:focus-within {
      grid-column: 1 / -1;
      grid-row: 4;
    }

    :global(html.js) .map:not(.is-full) .legend {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
    }

    /* In a column, counts read best as a right-aligned figure per row. */
    :global(html.js) .map:not(.is-full) .legend .n {
      margin-inline-start: auto;
    }
  }

  /* --- the full-screen app ----------------------------------------------
   * Not the Fullscreen API: iOS Safari refuses it for anything but video,
   * while a fixed overlay behaves identically everywhere. The figure itself
   * becomes the overlay — no DOM moves, so the canvas just observes a resize.
   */
  :global(html.emap-lock) {
    overflow: hidden;
  }

  :global(html.js) .map.is-full {
    position: fixed;
    inset: 0;
    z-index: 60;
    margin: 0;
    max-width: none;
    background: var(--bg);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 24rem);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem 1.5rem;
    padding: clamp(0.75rem, 2vw, 1.5rem);
    overflow: hidden;
  }

  .map.is-full > .stage {
    grid-column: 1;
    grid-row: 1 / 3;
    /* The app fills whatever screen it gets; the projection letterboxes
       inside and pan/zoom does the rest. */
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .map.is-full > .rail {
    grid-column: 2;
    grid-row: 1;
    min-height: 0;
    overflow-y: auto;
    display: grid;
    gap: 1.4rem;
    align-content: start;
    padding-inline-end: 0.25rem;
  }

  .map.is-full > figcaption {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
  }

  .map.is-full .legend {
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
  }

  .map.is-full .legend .n {
    margin-inline-start: auto;
  }

  .map.is-full .app-intro {
    display: grid;
    gap: 0.5rem;
  }

  .map.is-full .tools {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  /* A phone's full screen stacks: stage on top, instruments scroll below. */
  @media (max-width: 1099px) {
    :global(html.js) .map.is-full {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 55%) minmax(0, 1fr);
    }

    .map.is-full > .stage {
      grid-column: 1;
      grid-row: 1;
    }

    .map.is-full > .rail {
      grid-column: 1;
      grid-row: 2;
    }

    .map.is-full > figcaption {
      display: none;
    }
  }

  .app-intro {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
    line-height: 1.55;
    max-width: 30rem;
  }

  .app-title {
    color: var(--fg-faint);
    letter-spacing: 0.08em;
  }

  /* --- legend ---------------------------------------------------------- */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-end: 0.8rem;
  }

  .key {
    display: inline-flex;
    align-items: center;
    /* Buttons centre their text by UA default; a wrapped label in the rail
       would come out ragged-centred. */
    text-align: start;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
    background: none;
    border: 1px solid var(--rule);
    padding: 0.25em 0.7em;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .key:hover {
    color: var(--fg);
    border-color: var(--rule-strong);
  }

  .key[aria-pressed='true'] {
    color: var(--c, var(--fg));
    border-color: currentColor;
    background: color-mix(in oklab, var(--c, var(--accent)) 10%, transparent);
  }

  .key--all[aria-pressed='true'] {
    --c: var(--accent);
  }

  .key:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .swatch {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--c);
    flex-shrink: 0;
  }

  .n {
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  /* --- tools ----------------------------------------------------------- */
  /* The instruments live in the full-screen app only; on the landing the map
     is an artefact, not a cockpit. (Also hides them for no-JS visitors.) */
  .tools {
    display: none;
  }

  .tool-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
    background: none;
    border: 1px solid var(--rule);
    padding: 0.25em 0.7em;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .tool-btn:hover {
    color: var(--fg);
    border-color: var(--rule-strong);
  }

  .tool-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tool-btn[aria-pressed='true'] {
    color: var(--accent);
    border-color: currentColor;
    background: var(--accent-wash);
  }

  /* One label at a time, driven by state rather than by script-managed text. */
  .tool-btn .on {
    display: none;
  }

  .tool-btn[aria-pressed='true'] .on {
    display: inline;
  }

  .tool-btn[aria-pressed='true'] .off {
    display: none;
  }

  /* --- semantic search --------------------------------------------------- */
  .search {
    display: grid;
    gap: 0.45rem;
    justify-items: start;
    width: 100%;
    max-width: 22rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .search-title {
    color: var(--fg-dim);
  }

  .search-fine,
  .search-status {
    color: var(--fg-faint);
    line-height: 1.45;
  }

  .search-live {
    display: grid;
    gap: 0.45rem;
    width: 100%;
  }

  .search-live[hidden] {
    display: none;
  }

  .search input {
    width: 100%;
    background: var(--bg-inset);
    border: 1px solid var(--rule);
    color: var(--fg);
    font: inherit;
    padding: 0.5em 0.7em;
  }

  .search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .search-results {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.15rem;
    width: 100%;
  }

  /* The result rows are script-created, so Astro's scoping attribute never
     lands on them — these must be :global (contained by the scoped parent). */
  .search-results :global(button) {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
    min-height: 2rem;
    background: none;
    border: 0;
    padding: 0.2rem 0.1rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-dim);
    text-align: start;
    cursor: pointer;
  }

  .search-results :global(button:hover),
  .search-results :global(button:focus-visible) {
    color: var(--accent);
  }

  .search-results :global(.r-num) {
    margin-inline-start: auto;
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  .search-results :global(.r-none) {
    color: var(--fg-faint);
  }

  /* --- projection scrubber --------------------------------------------- */
  .variant {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    width: 100%;
    max-width: 22rem;
  }

  .variant label {
    color: var(--fg-dim);
  }

  .variant input {
    width: 100%;
    accent-color: var(--accent);
    /* The native track is a hair over 24px; give thumbs an honest target. */
    min-height: 1.7rem;
    cursor: ew-resize;
  }

  .variant input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .variant output {
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  /* --- stage ----------------------------------------------------------- */
  .stage {
    position: relative;
    border: 1px solid var(--rule);
    background:
      radial-gradient(
        120% 90% at 50% 45%,
        color-mix(in oklab, var(--accent) 5%, transparent),
        transparent 70%
      ),
      var(--bg-1);
    /* width first: aspect-ratio combined with a min-height would let the box
       compute a width wider than the viewport and scroll the whole page. */
    width: 100%;
    aspect-ratio: var(--aspect);
    overflow: hidden;
    /* Only meaningful with JS; the script reveals it. */
    display: none;
  }

  :global(html.js) .stage {
    display: block;
  }

  .abbr {
    display: none;
  }

  @media (max-width: 700px) {
    .full {
      display: none;
    }

    .abbr {
