  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
    /* pan-y, not none: the map is a large target on a phone, and swallowing
       vertical touch would trap anyone trying to scroll past it. A mouse is
       unaffected, so dragging still pans in both axes on a desktop. */
    touch-action: pan-y;
