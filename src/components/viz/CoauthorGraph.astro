---
import footprint from '@/data/viz/footprint.json';

/**
 * A force-directed graph with precomputed coordinates is a static picture.
 * networkx laid it out deterministically in Python (kamada_kawai), so this
 * renders as plain SVG with zero JavaScript and zero layout maths at runtime.
 */
const { nodes, edges } = footprint.coauthors;

const W = 1000;
const H = 620;
const PAD = 70;

const byId = new Map(nodes.map((n) => [n.id, n]));

/** Normalised [-1,1] coordinates onto the viewBox. */
const px = (x: number) => PAD + ((x + 1) / 2) * (W - PAD * 2);
const py = (y: number) => PAD + ((y + 1) / 2) * (H - PAD * 2);

const maxPapers = Math.max(...nodes.map((n) => n.papers));
const r = (papers: number) => 5 + (papers / maxPapers) * 13;

const maxWeight = Math.max(...edges.map((e) => e.w));
---

<figure class="graph">
  <figcaption>
    {nodes.length} coauthors across {footprint.headline.publications} publications. Node size is
    shared papers; a line means two people appeared on the same paper.
  </figcaption>

  <div class="scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Coauthor network diagram">
      <g class="edges">
        {
          edges.map((e) => {
            const a = byId.get(e.s);
            const b = byId.get(e.t);
            if (!a || !b) return null;
            return (
              <line
                x1={px(a.x)}
                y1={py(a.y)}
                x2={px(b.x)}
                y2={py(b.y)}
                stroke-width={0.5 + (e.w / maxWeight) * 2}
                opacity={0.18 + (e.w / maxWeight) * 0.4}
              />
            );
          })
        }
      </g>

      <g class="nodes">
        {
          nodes.map((n) => {
            const cx = px(n.x);
            const cy = py(n.y);
            const label = (
              <>
                <circle cx={cx} cy={cy} r={r(n.papers)} />
                <text x={cx} y={cy - r(n.papers) - 7} text-anchor="middle">
                  {n.name}
                </text>
                <title>
                  {n.name} — {n.papers} {n.papers === 1 ? 'paper' : 'papers'} together, since{' '}
                  {n.firstYear}
                </title>
              </>
            );
            return n.url ? (
              <a href={n.url} class="node node--link">
                {label}
              </a>
            ) : (
              <g class="node">{label}</g>
            );
          })
        }
      </g>
    </svg>
  </div>

  {/* Same content as a list: readable without SVG support, and by crawlers. */}
  <details class="table">
    <summary>as a table</summary>
    <table>
      <thead>
        <tr><th>coauthor</th><th>papers</th><th>since</th></tr>
      </thead>
      <tbody>
        {
          [...nodes]
            .sort((a, b) => b.papers - a.papers || a.name.localeCompare(b.name))
            .map((n) => (
              <tr>
                <td>{n.url ? <a href={n.url}>{n.name}</a> : n.name}</td>
                <td>{n.papers}</td>
                <td>{n.firstYear}</td>
              </tr>
            ))
        }
      </tbody>
    </table>
  </details>
</figure>

<style>
  .graph {
    margin: 0;
  }

  figcaption {
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-block-end: 1rem;
    max-width: var(--measure);
  }

  .scroll {
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: var(--bg-1);
  }

  svg {
    width: 100%;
    min-width: 40rem;
    height: auto;
    display: block;
  }

  .edges line {
    stroke: var(--rule-strong);
  }

  circle {
    fill: var(--bg-2);
    stroke: var(--accent);
    stroke-width: 1.5;
    transition:
      fill var(--dur-fast) var(--ease-out),
      stroke var(--dur-fast) var(--ease-out);
  }

  text {
    fill: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .node:hover circle,
  .node:focus-visible circle {
    fill: var(--accent);
  }

  .node:hover text,
  .node:focus-visible text {
    fill: var(--accent);
  }

  .node--link {
    cursor: pointer;
  }

  .table {
    margin-block-start: 1rem;
    font-size: var(--step--1);
  }

  .table summary {
    cursor: pointer;
    color: var(--fg-faint);
    width: fit-content;
  }

  .table summary:hover {
    color: var(--accent);
  }

  table {
    border-collapse: collapse;
    margin-block-start: 0.8rem;
    width: 100%;
    max-width: 30rem;
  }

  th,
  td {
    border: 1px solid var(--rule);
    padding: 0.35em 0.7em;
    text-align: start;
  }

  th {
    background: var(--bg-2);
    color: var(--fg-faint);
    font-weight: 500;
  }

  td {
    color: var(--fg-dim);
  }
</style>
